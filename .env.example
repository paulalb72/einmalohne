# SSH-Adresse des Repos – der Server klont es und pusht Änderungen dorthin
GIT_REPO=git@github.com:paulalb72/einmalohne.git
# Privater Deploy-Key (mit Schreibrecht) base64-kodiert: base64 -w0 deploy_key
GIT_SSH_KEY_B64=
# Geheimer Teil der Konnektor-Adresse https://einmalohne.de/mcp/<CONNECTOR_TOKEN>
CONNECTOR_TOKEN=
# Öffentliche Adresse für Links in Antworten und auf der Einrichtungsseite
PUBLIC_URL=https://einmalohne.de

# Optional
# GIT_BRANCH=main
# WORK_DIR=/tmp/einmalohne   # Arbeitskopie
# PORT=3000
